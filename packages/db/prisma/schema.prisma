// packages/db/prisma/schema.prisma
//
// IMPORTANT: Access control is enforced at the application layer (apps/api services).
// Never expose DATABASE_URL to any frontend or untrusted client.
//
// EHR credentials are encrypted at the application layer using AES-256-GCM
// (see apps/api/src/lib/crypto.ts). The DB stores only the ciphertext.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum AppRole {
  clinician
  facility_admin
  carevault_admin
  researcher

  @@map("app_role")
}

enum FacilityStatus {
  online
  degraded
  offline

  @@map("facility_status")
}

// ── Core tables ────────────────────────────────────────────────────────────

model Profile {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  passwordHash String    @default("") @map("password_hash")
  fullName     String    @default("") @map("full_name")
  facilityId   String?   @map("facility_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastSignIn   DateTime? @map("last_sign_in")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  facility            Facility?            @relation(fields: [facilityId], references: [id])
  userRole            UserRole?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("profiles")
}

// One role per user (UNIQUE on user_id added in migration 20260517000003).
model UserRole {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String  @unique @map("user_id") @db.Uuid
  role   AppRole

  profile Profile @relation(fields: [userId], references: [id])

  @@map("user_roles")
}

model Facility {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  location     String
  state        String
  facilityCode String?        @unique @map("facility_code")
  ehrSystem    String         @default("OpenMRS") @map("ehr_system")
  status       FacilityStatus @default(online)
  uptime       Decimal        @default(99.00) @db.Decimal(5, 2)
  recordsCount Int            @default(0) @map("records_count")
  lastSync     DateTime?      @map("last_sync")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  profiles                   Profile[]
  patients                   Patient[]
  encounters                 Encounter[]
  vitalRecords               VitalRecord[]
  medications                Medication[]
  allergies                  Allergy[]
  labResults                 LabResult[]
  stagedRecords              StagedRecord[]
  facilityConnections        FacilityConnection[]
  syncLogs                   SyncLog[]
  auditLogs                  AuditLog[]
  researchProjectFacilities  ResearchProjectFacility[]

  @@map("facilities")
}

model Patient {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nin         String   @unique
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  gender      String   // "Male" | "Female"
  phone       String?
  bloodGroup  String?  @map("blood_group")
  genotype    String?
  facilityId  String?  @map("facility_id") @db.Uuid
  lga         String?
  state       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  facility     Facility?     @relation(fields: [facilityId], references: [id])
  encounters   Encounter[]
  vitalRecords VitalRecord[]
  medications  Medication[]
  allergies    Allergy[]
  labResults   LabResult[]

  @@index([facilityId], map: "idx_patients_facility")
  @@index([lastName, firstName], map: "idx_patients_name")
  @@map("patients")
}

// ── Clinical tables ────────────────────────────────────────────────────────
// Authoritative schema: 20260516000000_clinical_data_tables.sql
// Note: encounters.type (not encounter_type), lab_results.test (not test_name)

model Encounter {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  facilityId    String?  @map("facility_id") @db.Uuid
  facilityName  String   @default("") @map("facility_name")
  practitioner  String   @default("")
  encounterDate DateTime @map("encounter_date") @db.Date
  type          String   @default("Outpatient")
  diagnosis     String   @default("")
  notes         String   @default("")
  status        String   @default("completed") // "completed" | "in-progress"
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  patient    Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility   Facility?  @relation(fields: [facilityId], references: [id])
  labResults LabResult[]

  @@index([patientId])
  @@map("encounters")
}

model VitalRecord {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  facilityId   String?  @map("facility_id") @db.Uuid
  facilityName String   @default("") @map("facility_name")
  recordedDate DateTime @map("recorded_date") @db.Date
  systolic     Int?
  diastolic    Int?
  heartRate    Int?     @map("heart_rate")
  temperature  Decimal? @db.Decimal(4, 1)
  weight       Decimal? @db.Decimal(5, 1)
  spo2         Int?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility Facility? @relation(fields: [facilityId], references: [id])

  @@index([patientId])
  @@map("vital_records")
}

model Medication {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  facilityId   String?   @map("facility_id") @db.Uuid
  facilityName String    @default("") @map("facility_name")
  name         String
  dosage       String    @default("")
  frequency    String    @default("")
  prescribedBy String    @default("") @map("prescribed_by")
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  status       String    @default("active") // "active" | "completed" | "discontinued"
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility Facility? @relation(fields: [facilityId], references: [id])

  @@index([patientId])
  @@map("medications")
}

model Allergy {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  facilityId   String?  @map("facility_id") @db.Uuid
  facilityName String   @default("") @map("facility_name")
  substance    String
  reaction     String   @default("")
  severity     String   @default("mild") // "mild" | "moderate" | "severe"
  reportedBy   String   @default("") @map("reported_by")
  dateRecorded DateTime @map("date_recorded") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility Facility? @relation(fields: [facilityId], references: [id])

  @@index([patientId])
  @@map("allergies")
}

model LabResult {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  facilityId     String?  @map("facility_id") @db.Uuid
  facilityName   String   @default("") @map("facility_name")
  encounterId    String?  @map("encounter_id") @db.Uuid
  test           String
  result         String
  unit           String   @default("")
  referenceRange String   @default("") @map("reference_range")
  resultDate     DateTime @map("result_date") @db.Date
  status         String   @default("normal") // "normal" | "abnormal" | "critical"
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility  Facility?  @relation(fields: [facilityId], references: [id])
  encounter Encounter? @relation(fields: [encounterId], references: [id])

  @@index([patientId])
  @@map("lab_results")
}

// ── Workflow tables ────────────────────────────────────────────────────────

model StagedRecord {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientName        String   @map("patient_name")
  nin                String
  sourceFacilityId   String?  @map("source_facility_id") @db.Uuid
  sourceFacilityName String   @map("source_facility_name")
  dataType           String   @map("data_type")
  submittedAt        DateTime @default(now()) @map("submitted_at")
  // "pending" | "approved" | "rejected" | "needs-review"
  status             String   @default("pending")
  // "low" | "medium" | "high" | "critical"
  priority           String   @default("medium")
  summary            String
  practitioner       String
  conflictType       String?  @map("conflict_type")
  flagged            Boolean  @default(false)
  adminNotes         String?  @map("admin_notes")
  fhirResourceType   String?  @map("fhir_resource_type")
  fhirPayload        Json?    @map("fhir_payload")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  sourceFacility Facility? @relation(fields: [sourceFacilityId], references: [id])

  @@map("staged_records")
}

model FacilityConnection {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facilityId               String    @map("facility_id") @db.Uuid
  ehrType                  String    @default("OpenMRS") @map("ehr_type")
  baseUrl                  String    @map("base_url")
  // "basic" | "oauth2" | "api_key"
  authType                 String    @default("basic") @map("auth_type")
  // AES-256-GCM ciphertext of the JSON credentials blob. Encrypted/decrypted
  // by apps/api/src/lib/crypto.ts using the ENCRYPTION_KEY env var (32 bytes,
  // base64-encoded). Never stored or transmitted in plaintext.
  authCredentials          String    @map("auth_credentials")
  fhirVersion              String    @default("R4") @map("fhir_version")
  // "pull" | "push" | "bidirectional"
  syncDirection            String    @default("pull") @map("sync_direction")
  syncIntervalMinutes      Int       @default(60) @map("sync_interval_minutes")
  isActive                 Boolean   @default(true) @map("is_active")
  lastSuccessfulSync       DateTime? @map("last_successful_sync")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  facility Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  syncLogs SyncLog[]

  @@unique([facilityId, ehrType])
  @@index([isActive])
  @@map("facility_connections")
}

model SyncLog {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facilityConnectionId String?   @map("facility_connection_id") @db.Uuid
  facilityId           String    @map("facility_id") @db.Uuid
  // "inbound" | "outbound"
  direction            String    @default("inbound")
  // "pending" | "in_progress" | "completed" | "failed" | "retrying"
  status               String    @default("pending")
  recordsProcessed     Int       @default(0) @map("records_processed")
  recordsFailed        Int       @default(0) @map("records_failed")
  errorMessage         String?   @map("error_message")
  errorDetails         Json?     @map("error_details")
  retryCount           Int       @default(0) @map("retry_count")
  maxRetries           Int       @default(3) @map("max_retries")
  nextRetryAt          DateTime? @map("next_retry_at")
  startedAt            DateTime  @default(now()) @map("started_at")
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  facility           Facility?           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  facilityConnection FacilityConnection? @relation(fields: [facilityConnectionId], references: [id])

  @@index([facilityId])
  @@index([status])
  @@map("sync_logs")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // userId references profiles(id). No FK so the audit row survives if a profile
  // is hard-deleted — NDPA requires retaining the action trail.
  userId       String   @map("user_id") @db.Uuid
  userName     String   @default("") @map("user_name")
  role         String   @default("clinician")
  action       String   // AuditAction values
  resource     String   @default("")
  facilityId   String?  @map("facility_id") @db.Uuid
  facilityName String   @default("") @map("facility_name")
  ipAddress    String   @default("—") @map("ip_address")
  // "success" | "failure" | "warning"
  status       String   @default("success")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  facility Facility? @relation(fields: [facilityId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ── Research tables ────────────────────────────────────────────────────────

model ResearchProject {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String
  description         String
  purpose             String
  requestedFacilityIds String[] @map("requested_facility_ids") @db.Uuid
  dateFrom            DateTime  @map("date_from") @db.Date
  dateTo              DateTime  @map("date_to") @db.Date
  // draft | pending_carevault | pending_facilities | approved | rejected | completed
  status              String    @default("draft")
  createdBy           String    @map("created_by") @db.Uuid
  submittedAt         DateTime? @map("submitted_at")
  carevaultDecision   String?   @map("carevault_decision")
  carevaultNotes      String?   @map("carevault_notes")
  carevaultDecidedBy  String?   @map("carevault_decided_by") @db.Uuid
  carevaultDecidedAt  DateTime? @map("carevault_decided_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  facilities ResearchProjectFacility[]
  audit      ResearchProjectAudit[]

  @@index([createdBy])
  @@map("research_projects")
}

model ResearchProjectFacility {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  facilityId    String    @map("facility_id") @db.Uuid
  // "pending" | "approved" | "rejected"
  status        String    @default("pending")
  decisionNotes String?   @map("decision_notes")
  decidedBy     String?   @map("decided_by") @db.Uuid
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  project  ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  facility Facility        @relation(fields: [facilityId], references: [id])

  @@unique([projectId, facilityId])
  @@index([facilityId])
  @@map("research_project_facilities")
}

model ResearchProjectAudit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  project ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("research_project_audit")
}

// ── Auth tokens ────────────────────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
