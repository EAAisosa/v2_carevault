NODE_ENV=development
PORT=4000

# PostgreSQL connection string — point at your local or remote Postgres instance
# Never use a connection pooler URL here; Prisma requires a direct connection for migrations
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/carevault"

# JWT signing secrets — generate two separate, strong random secrets (min 64 chars each)
# Example: openssl rand -hex 64
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-strong-random-secret"

# 32-byte symmetric key for AES-256-GCM encryption of EHR credentials.
# Generate with: openssl rand -base64 32
# Rotation: re-encrypt all facility_connections rows in a one-shot script, then swap.
ENCRYPTION_KEY="replace-with-base64-of-32-random-bytes"

# Secret used to protect the internal /internal/auto-sync cron endpoint
# Example: openssl rand -hex 32
CRON_SECRET="replace-with-a-random-secret"

# Frontend origin(s) — comma-separated, used for CORS
ALLOWED_ORIGINS="http://localhost:3000"

# Public URL of the web app — used to build password-reset and invite links
APP_URL="http://localhost:3000"
